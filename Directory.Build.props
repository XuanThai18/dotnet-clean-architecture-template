<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Warning là lỗi; riêng cảnh báo lỗ hổng gói mức thấp/vừa/cao vẫn để warning, mức critical (NU1904) chặn build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Cần cho IDE0005 (using thừa) khi build; CS1591 tắt vì không bắt buộc XML doc cho mọi member public. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--#if (false) -->
  <!-- CHỈ dành cho source của template: bật các khối "#if (AuthLocal)" để build/test đủ mọi module.
       Project sinh ra không cần (engine đã giữ hoặc gỡ sẵn các khối đó) nên khối này luôn bị xoá khi tạo project.
       Lưu ý: XML comment không được chứa hai dấu gạch liền nhau. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AuthLocal</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

</Project>
