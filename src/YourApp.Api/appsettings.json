{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  // Giá trị thật đặt qua biến môi trường / secret store, vd ConnectionStrings__DefaultConnection, JwtSettings__Secret.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "Issuer": "YourApp",
    "Audience": "YourApp",
    "Secret": "",
    "ClockSkewSeconds": 30
  },
  //#if (AuthLocal)
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshReuseGraceSeconds": 10,
    "AllowSelfRegistration": false,
    "RefreshToken": {
      "DefaultTransport": "Cookie",
      "CookieName": "yourapp_refresh",
      "CookiePath": "/api/v1/auth",
      "SameSite": "Strict"
    },
    // Tài khoản Admin đầu tiên, chỉ tạo khi bảng users còn trống. Đặt qua biến môi trường, đừng ghi ở đây.
    "SeedAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  //#endif
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SensitivePermitLimit": 100
  },
  "Security": {
    "UseHttpsRedirection": false,
    "KnownNetworks": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  }
}
