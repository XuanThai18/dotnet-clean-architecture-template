{
  // Chỉ dùng cho máy dev (docker compose up postgres redis). KHÔNG dùng các giá trị này ở môi trường khác.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=yourapp;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "dev-only-secret-change-me-0123456789abcdef"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
