# Copy file này thành .env (đã có trong .gitignore) rồi đổi giá trị.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yourapp
# Cổng Postgres trên máy host; khớp với ConnectionStrings trong appsettings.Development.json
POSTGRES_PORT=5433

# Tối thiểu 32 ký tự. Tạo ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
