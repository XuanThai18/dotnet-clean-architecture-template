{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        // In mọi câu SQL EF Core sinh ra kèm thời gian chạy, để soi truy vấn ngay lúc viết code.
        // Giá trị tham số vẫn ẩn (cần EnableSensitiveDataLogging mới hiện). Ồn quá thì đổi lại "Warning".
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  // Chỉ dùng cho máy dev (docker compose up postgres redis). KHÔNG dùng các giá trị này ở môi trường khác.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=yourapp;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "dev-only-secret-change-me-0123456789abcdef"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  //#if (AuthLocal)
  // Admin dùng thử ở máy dev; đổi mật khẩu sau lần đăng nhập đầu.
  "Auth": {
    "SeedAdmin": {
      "Email": "admin@example.com",
      "Password": "ChangeMe123!"
    }
  },
  //#endif
  "Database": {
    "MigrateOnStartup": true
  }
}
